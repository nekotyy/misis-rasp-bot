# =========================
# General application setup
# =========================

# Main timezone for scheduler, logs, date calculations and Docker containers.
# Usually keep Europe/Moscow for this project.
APP_TIMEZONE=Europe/Moscow

# Delay between background requests to different schedule sources.
# Increase if the schedule site starts rate-limiting or becomes unstable.
SCHEDULE_REQUEST_DELAY_SECONDS=10

# Random jitter added on top of SCHEDULE_REQUEST_DELAY_SECONDS.
# Helps avoid too predictable request bursts.
SCHEDULE_REQUEST_JITTER_SECONDS=8

# Base schedule URL.
# Default points to MISIS college schedule. Usually менять не нужно.
SCHEDULE_URL=http://asu.sf-misis.ru/rasp/600

# Local SQLite path when running without Docker.
# In Docker this path is overridden to /app/runtime/bot.db.
DATABASE_PATH=bot.db

# Local attachments directory when running without Docker.
# In Docker this path is overridden to /app/runtime/attachments.
ATTACHMENTS_PATH=storage/attachments


# =========================
# Bot administrators
# =========================

# Telegram user ID of the main bot administrator.
# Leave empty if Telegram admin notifications are not needed.
ADMIN_TELEGRAM_ID=

# VK user ID of the main bot administrator.
# Leave empty if VK admin notifications are not needed.
ADMIN_VK_ID=


# =========================
# Telegram / VK bot tokens
# =========================

# Telegram bot token from BotFather.
# If empty, Telegram bot will not start.
TELEGRAM_BOT_TOKEN=

# VK community bot token.
# If empty, VK bot will not start.
VK_BOT_TOKEN=

# Disable SSL verification for VK HTTP client.
# Keep false in normal environments.
# Switch to true only if you really know that the host has broken CA / SSL.
VK_DISABLE_SSL_VERIFY=false


# =========================
# RabbitMQ
# =========================

# AMQP connection string.
# In Docker the hostname should normally be rabbitmq.
# Example: amqp://guest:guest@rabbitmq:5672/
# If empty, the project falls back to direct delivery without queue broker.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Queue for regular outbound notifications.
RABBITMQ_QUEUE=misis_notifications

# Number of messages one consumer can take at once.
# Smaller = softer load, bigger = higher throughput.
RABBITMQ_PREFETCH_COUNT=20


# =========================
# Lesson counters
# =========================

# Global feature switch for lesson counters.
# false = bot will not count passed lessons automatically.
# true = nightly jobs and lesson counter consumer are enabled.
LESSON_COUNTERS_ENABLED=false

# Path to lesson counter JSON config.
# In Docker this path is overridden to /app/runtime/lesson_counters.json.
LESSON_COUNTERS_PATH=storage/lesson_counters.json

# Separate RabbitMQ queue for lesson counter jobs.
# Keeps lesson counting isolated from user notification flow.
LESSON_COUNTERS_QUEUE=misis_lesson_counters


# =========================
# Web dashboard auth
# =========================

# Secret for signing dashboard session cookies.
# MUST be changed in production.
WEB_CONFIG_SECRET=change-me-long-random-secret

# Built-in dashboard superuser login.
WEB_SUPERUSER_LOGIN=admin

# Built-in dashboard superuser password.
# MUST be changed in production.
WEB_SUPERUSER_PASSWORD=change-me

# Optional path to old JSON web users file for one-time import into SQLite.
# Leave as-is only if you used legacy JSON-based dashboard accounts before.
# New web users are now stored in SQLite table web_users.
WEB_USERS_JSON_IMPORT_PATH=storage/web_users.json

# Direct web dashboard port when nginx is disabled.
# Example URL without nginx: http://server-ip:8080
WEB_PORT=8080


# =========================
# Optional nginx reverse proxy
# =========================

# nginx is optional.
# If empty, docker compose starts bot + rabbitmq + web without nginx.
# If set to nginx, docker compose also starts nginx profile automatically.
# Example:
#   COMPOSE_PROFILES=nginx
# With that value you get:
#   http://dashboard.nekoty.ru
#   https://dashboard.nekoty.ru:2443
COMPOSE_PROFILES=

# Public hostname used by nginx virtual host.
NGINX_SERVER_NAME=dashboard.nekoty.ru

# External HTTP port for nginx.
NGINX_HTTP_PORT=80

# External HTTPS port for nginx.
# The project intentionally uses 2443, not standard 443.
NGINX_HTTPS_PORT=2443

# Internal upstream that nginx proxies to.
# Usually менять не нужно.
WEB_UPSTREAM=web:8080

# Path inside nginx container to fullchain certificate.
# By default certificates are mounted from ./deploy/certs -> /etc/letsencrypt
NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/dashboard.nekoty.ru/fullchain.pem

# Path inside nginx container to private key.
NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/dashboard.nekoty.ru/privkey.pem
