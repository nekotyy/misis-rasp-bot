# =========================
# Общая настройка приложения
# =========================

# Основная таймзона для планировщика, логов, расчетов дат и Docker-контейнеров.
# Для этого проекта обычно оставляют Europe/Moscow.
APP_TIMEZONE=Europe/Moscow

# Задержка между фоновыми запросами к разным источникам расписания.
# Увеличивай, если сайт расписания начинает тормозить или ограничивать запросы.
SCHEDULE_REQUEST_DELAY_SECONDS=10

# Случайный разброс, который добавляется поверх SCHEDULE_REQUEST_DELAY_SECONDS.
# Нужен, чтобы фоновые запросы не выглядели слишком ровными и предсказуемыми.
SCHEDULE_REQUEST_JITTER_SECONDS=8

# Базовый URL расписания.
# По умолчанию указывает на расписание колледжа МИСИС. Обычно менять не нужно.
SCHEDULE_URL=http://asu.sf-misis.ru/rasp/

# Путь к локальной SQLite-базе при запуске без Docker.
# В Docker этот путь переопределяется на /app/runtime/bot.db.
DATABASE_PATH=bot.db

# Локальная папка для вложений при запуске без Docker.
# В Docker этот путь переопределяется на /app/runtime/attachments.
ATTACHMENTS_PATH=storage/attachments


# =========================
# Администраторы бота
# =========================

# Telegram user ID основного администратора бота.
# Можно указать несколько через запятую: 123456789, 987654321
# Оставь пустым, если уведомления администратору в Telegram не нужны.
ADMIN_TELEGRAM_ID=

# Telegram user ID ограниченных администраторов.
# Имеют доступ к админ-панели, но не могут рассылать сообщения всем,
# скачивать БД и управлять счетчиками пар.
# Несколько ID через запятую.
LIMITED_ADMIN_TELEGRAM_IDS=

# VK user ID основного администратора бота.
# Оставь пустым, если уведомления администратору во VK не нужны.
ADMIN_VK_ID=


# =========================
# Токены Telegram / VK
# =========================

# Токен Telegram-бота от BotFather.
# Если пустой, Telegram-бот не будет запущен.
TELEGRAM_BOT_TOKEN=

# Необязательный HTTP/SOCKS-прокси только для запросов Telegram Bot API.
# При запуске в Docker используй адрес хоста, доступный из контейнера,
# например socks5://host.docker.internal:2080, а не 127.0.0.1 хоста.
TELEGRAM_PROXY=

# Токен сообщества VK.
# Если пустой, VK-бот не будет запущен.
VK_BOT_TOKEN=

# Отключение SSL-проверки для VK HTTP-клиента.
# В нормальной среде оставляй false.
# Переключай в true только если точно понимаешь, что на хосте проблемы с CA / SSL.
VK_DISABLE_SSL_VERIFY=false


# =========================
# RabbitMQ
# =========================

# Строка подключения AMQP.
# В Docker именем хоста обычно должен быть rabbitmq.
# Пример: amqp://guest:guest@rabbitmq:5672/
# Если переменная пустая, проект переходит на прямую доставку без брокера очередей.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Очередь для обычных исходящих уведомлений.
RABBITMQ_QUEUE=misis_notifications

# Сколько сообщений один consumer может взять в работу одновременно.
# Меньше = мягче нагрузка, больше = выше пропускная способность.
RABBITMQ_PREFETCH_COUNT=20


# =========================
# Счетчики пар
# =========================

# Глобальный переключатель счетчиков пар.
# false = бот не будет автоматически считать прошедшие пары.
# true = включаются ночные задачи и consumer счетчиков пар.
LESSON_COUNTERS_ENABLED=false

# Путь к JSON-конфигу счетчиков пар.
# В Docker этот путь переопределяется на /app/runtime/lesson_counters.json.
LESSON_COUNTERS_PATH=storage/lesson_counters.json

# Отдельная очередь RabbitMQ для задач подсчета пар.
# Нужна, чтобы подсчет пар не смешивался с очередью пользовательских уведомлений.
LESSON_COUNTERS_QUEUE=misis_lesson_counters


# =========================
# Импорт расписания с фото (OCR через Gemini)
# =========================

# Резервный способ обновить расписание, когда сайт недоступен:
# админ присылает боту фото расписания, бот распознает его через Gemini и
# проводит через тот же конвейер, что и данные с сайта.
#
# Распознавание идёт через неофициальный веб-клиент Gemini (библиотека
# gemini_webapi, https://github.com/HanaokaYuzu/Gemini-API), авторизованный
# куки обычного Google-аккаунта — платный API-ключ не нужен. Учти: это не
# официальный API, а доступ поверх веб-интерфейса gemini.google.com, куки
# протухают и требуют обновления, а массовая автоматизация через личный
# аккаунт может нарушать условия использования Google.
OCR_ENABLED=true

# Куки Google-аккаунта, от имени которого идут запросы к Gemini.
# Достаются из браузера после входа на gemini.google.com:
# DevTools -> Application/Storage -> Cookies -> https://gemini.google.com,
# значения полей __Secure-1PSID и __Secure-1PSIDTS.
# __Secure-1PSIDTS автоматически обновляется библиотекой и сохраняется в
# runtime-кэш. В Docker его новое значение также записывается обратно в .env.
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Путь к .env, куда записывать обновлённые cookies и ID созданного Gem.
# Для запуска без Docker обычно достаточно .env; compose задаёт путь сам.
GEMINI_ENV_PATH=.env

# Интервал встроенного auto-refresh cookies (не меньше 60 секунд).
GEMINI_REFRESH_INTERVAL_SECONDS=600

# ID кастомного Gem запишется сюда автоматически после первого запуска.
GEMINI_OCR_GEM_ID=

# Прокси для запросов к Gemini в формате http(s)://host:port. Пусто = напрямую.
GEMINI_PROXY=

# Необязательный DoH только для запросов Gemini. Например:
# GEMINI_DOH_URL=https://xbox-dns.ru/dns-query
# Пусто = DoH отключён, используется обычный системный/Docker DNS. Telegram,
# RabbitMQ, сайт расписания и остальные части приложения эта настройка не меняет.
GEMINI_DOH_URL=

# Предпочтительная модель Gemini. Если её нет в аккаунте, бот динамически
# выберет актуальную Flash-модель, а затем модель аккаунта по умолчанию.
OCR_GEMINI_MODEL=gemini-3.8-flash

# Таймаут распознавания одного изображения в секундах.
OCR_TIMEOUT_SECONDS=60

# Порог уверенности: ниже него бот предупредит админа перед подтверждением.
OCR_MIN_CONFIDENCE=0.6

# Порог похожести для автоисправления по прошлым снимкам (0.5-1.0).
# Выше = строже, меньше ложных замен, но и меньше починенных опечаток.
OCR_FUZZY_THRESHOLD=0.78


# =========================
# Авторизация веб-дашборда
# =========================

# Секрет для подписи cookie-сессий дашборда.
# В проде обязательно замени.
WEB_CONFIG_SECRET=default-dev-secret-key-change-in-production-32chars

# Логин встроенного суперпользователя дашборда.
WEB_SUPERUSER_LOGIN=admin

# Пароль встроенного суперпользователя дашборда.
# В проде обязательно замени.
WEB_SUPERUSER_PASSWORD=admin-password-change-me

# Строгая проверка безопасности при старте веб-админки.
# Если =1, приложение откажется запускаться с дефолтными/небезопасными credentials.
# Рекомендуется включать в production.
# WEB_ENFORCE_SECURITY=1
WEB_COOKIE_SECURE=true
WEB_SESSION_TTL_SECONDS=43200

# Необязательный путь к старому JSON-файлу веб-пользователей для одноразового импорта в SQLite.
# Оставляй как есть только если раньше использовал старую JSON-схему хранения аккаунтов дашборда.
# Новые веб-пользователи теперь хранятся в SQLite-таблице web_users.
WEB_USERS_JSON_IMPORT_PATH=storage/web_users.json
WEB_BIND_IP=127.0.0.1

# Прямой внешний порт веб-дашборда, если nginx отключен.
# Пример доступа без nginx: http://server-ip:8080
WEB_PORT=8080


# =========================
# Необязательный nginx reverse proxy
# =========================

# nginx в проекте необязателен.
# Если оставить пустым, docker compose поднимет bot + rabbitmq + web без nginx.
# Если указать nginx, compose автоматически поднимет и профиль nginx.
# Пример:
#   COMPOSE_PROFILES=nginx
# Тогда доступ будет таким:
#   http://dashboard.example.com
#   https://dashboard.example.com
COMPOSE_PROFILES=

# Публичное доменное имя для nginx virtual host.
NGINX_SERVER_NAME=dashboard.example.com

# Внешний HTTP-порт для nginx.
NGINX_HTTP_PORT=80

# Внешний HTTPS-порт для nginx.
# Обычно здесь оставляют стандартный 443.
# Внутри контейнера nginx продолжает слушать 2443, а compose пробрасывает наружу тот порт, который указан здесь.
NGINX_HTTPS_PORT=443

# Внутренний upstream, в который nginx проксирует трафик.
# Обычно менять не нужно.
WEB_UPSTREAM=web:8080

# Путь внутри nginx-контейнера к fullchain-сертификату.
# По умолчанию сертификаты монтируются из ./deploy/certs -> /etc/letsencrypt
NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/dashboard.example.com/fullchain.pem

# Путь внутри nginx-контейнера к приватному ключу.
NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/dashboard.example.com/privkey.pem

# Устанавливать сессию Gemini при старте, а не при первом фото.
# true = первое фото распознаётся сразу, старт занимает на пару секунд дольше.
# false = сессия установится лениво при первом фото.
OCR_WARMUP_ON_START=true

# Как часто напоминать администраторам о готовности распознавания, в часах.
# Защита от спама: при перезапусках контейнера сообщение шлётся не чаще этого срока.
# 0 = слать при каждом старте.
OCR_READY_NOTICE_HOURS=12
